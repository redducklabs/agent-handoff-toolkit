{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -m agent_handoff_toolkit hook --platform claude --event session-start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -m agent_handoff_toolkit hook --platform claude --event post-tool-use"
          }
        ]
      }
    ]
  }
}
